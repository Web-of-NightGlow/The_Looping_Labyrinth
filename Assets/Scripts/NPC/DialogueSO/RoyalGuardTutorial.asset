  m_Script: {fileID: 11500000, guid: 50c0649020f776f4d9c6cc2cdea5bed4, type: 3}
  m_Name: RoyalGuardTutorial
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 4c029433c2ef566489f3dd396015a856, type: 2}
    text: Greetings young fighter, I hope you are prepared to learn the basics before
      you enter the Labyrinth!
  - speaker: {fileID: 11400000, guid: 4c029433c2ef566489f3dd396015a856, type: 2}
    text: Each Class has a special ability that can be used with J. But, it has a
      large cooldown so use is wisely!
  - speaker: {fileID: 11400000, guid: 4c029433c2ef566489f3dd396015a856, type: 2}
    text: Any interactions with NPCs or the enviorment use E.
  - speaker: {fileID: 11400000, guid: cfe140c918cbe5549aee48ba73140407, type: 2}
    text: Okay!
